{
  // 该子项目只负责类型检查 vite.config.ts（构建配置本身），由 tsconfig.json 以
  // project reference 引用。composite 项目不允许 noEmit：被引用方必须产出 .d.ts
  // 供引用方消费，否则 tsc 直接报 TS6310 并中止——过去 npm run build 里的
  // vue-tsc 就是因此从未真正跑过。故这里改为「只产出声明文件」，并把产物丢到
  // node_modules/.tmp 下，不污染仓库。
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts"]
}
